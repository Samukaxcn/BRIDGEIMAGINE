{
  "name": "bridgeimagine",
  "version": "0.1.0",
  "private": true,
  "description": "Organizador local de fotografias",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack:win": "electron-builder --win portable",
    "test:gui": "node gui-check.cjs"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.0.12",
    "playwright-core": "1.58.2"
  },
  "build": {
    "appId": "com.bridgeimagine.desktop",
    "productName": "BRIDGEIMAGINE",
    "files": [
      "main.cjs",
      "preload.cjs",
      "library.cjs",
      "ui/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
